{
  "version": 6,

  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Windows-Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Windows-Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },


    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Linux-Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Linux-Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },


    {
      "name": "androidtv-debug",
      "displayName": "Android TV Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/AndroidTV-Debug",
      "toolchainFile": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-26",
        "ANDROID_STL": "c++_shared",
        "APP_ANDROID_TV": "ON"
      }
    },
    {
      "name": "androidtv-release",
      "displayName": "Android TV Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/AndroidTV-Release",
      "toolchainFile": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-26",
        "ANDROID_STL": "c++_shared",
        "APP_ANDROID_TV": "ON"
      }
    },


    {
      "name": "android-debug",
      "displayName": "Android Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Android-Debug",
      "toolchainFile": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-26",
        "ANDROID_STL": "c++_shared",
        "APP_ANDROID_TV": "OFF"
      }
    },
    {
      "name": "android-release",
      "displayName": "Android Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Android-Release",
      "toolchainFile": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-26",
        "ANDROID_STL": "c++_shared",
        "APP_ANDROID_TV": "OFF"
      }
    }
  ],


  "buildPresets": [
    {
      "name": "build-windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "build-windows-release",
      "configurePreset": "windows-release"
    },


    {
      "name": "build-linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "build-linux-release",
      "configurePreset": "linux-release"
    },


    {
      "name": "build-androidtv-debug",
      "configurePreset": "androidtv-debug"
    },
    {
      "name": "build-androidtv-release",
      "configurePreset": "androidtv-release"
    },


    {
      "name": "build-android-debug",
      "configurePreset": "android-debug"
    },
    {
      "name": "build-android-release",
      "configurePreset": "android-release"
    }
  ]
}