#include <windows.h>

LANGUAGE LANG_POLISH, SUBLANG_DEFAULT

VS_VERSION_INFO VERSIONINFO

	FILEVERSION @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
	PRODUCTVERSION @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0

	FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
	FILEFLAGS 0
	FILEOS VOS_NT_WINDOWS32
	FILETYPE VFT_APP
	FILESUBTYPE 0
	
BEGIN

	BLOCK "StringFileInfo"
	BEGIN
	
		BLOCK "041504B0"
		BEGIN
			VALUE "CompanyName", "ZupaNET Development"
			VALUE "FileDescription", "Tablica Znakowa"
			VALUE "FileVersion", "@APP_VERSION_STRING@"
			VALUE "ProductName", "Tablica Znakowa"
			VALUE "ProductVersion", "@APP_VERSION_STRING@"
			VALUE "OriginalFilename", "tablica.exe"
			VALUE "LegalCopyright", "Copyright ZupaNET Development c 2026"
		END
		
	END
	
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0415, 1200
	END

END
	